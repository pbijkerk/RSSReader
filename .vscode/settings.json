{
  // --- SweetPad: build/run/debug via het Xcode-project ---
  "sweetpad.build.xcodeWorkspacePath": "RSSReader.xcodeproj/project.xcworkspace",

  // --- Swift / SourceKit-LSP ---
  // Code-intelligence vereist buildServer.json (zie README / xcode-build-server).
  "swift.autoGenerateLaunchConfigurations": false,
  "[swift]": {
    "editor.defaultFormatter": "vknabel.vscode-swiftformat",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // --- Werkruimte-hygiëne ---
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "build": true,
    "DerivedData": true,
    "**/*.xcuserstate": true
  },
  "search.exclude": {
    "build": true,
    "DerivedData": true,
    "**/*.xcodeproj/**": true
  },

  // --- Documentatie (repo is markdown-zwaar) ---
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  }
}
