{
  // --- SweetPad: build/run/debug via het Xcode-project ---
  "sweetpad.build.xcodeWorkspacePath": "RSSReader.xcodeproj/project.xcworkspace",

  // --- Swift / SourceKit-LSP ---
  // Code-intelligence vereist buildServer.json (zie README / xcode-build-server).
  // Formatteren gebeurt met swift-format uit de Xcode-toolchain, gestuurd door
  // .swift-format in de repo-root; de officiële Swift-extensie roept die aan.
  "swift.autoGenerateLaunchConfigurations": false,
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  // --- Werkruimte-hygiëne ---
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "build": true,
    "DerivedData": true,
    "**/*.xcuserstate": true
  },
  "search.exclude": {
    "build": true,
    "DerivedData": true,
    "**/*.xcodeproj/**": true
  },

  // --- Documentatie (repo is markdown-zwaar) ---
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  }
}
